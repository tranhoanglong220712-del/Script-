-- Helper: Get Player Screen Pos & Distance
local function getTargetData(character)
    if not character or not character:FindFirstChild("HumanoidRootPart") or not character:FindFirstChild("Humanoid") then return nil end
    local hrp = character.HumanoidRootPart
    local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
    return pos, onScreen, hrp
end

