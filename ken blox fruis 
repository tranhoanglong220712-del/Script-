-- ESP Feature Setup
local function removeESP(plr)
    if ESPCache[plr] then
        for _, obj in pairs(ESPCache[plr]) do
            obj:Remove()
        end
        ESPCache[plr] = nil
    end
end

local function getESP(plr)
    if not ESPCache[plr] then
        ESPCache[plr] = {
            Box = Drawing.new("Square"),
            Line = Drawing.new("Line"),
            Name = Drawing.new("Text"),
            HealthBG = Drawing.new("Square"),
            HealthFill = Drawing.new("Square")
        }
        local d = ESPCache[plr]
        d.Box.Thickness = 1
        d.Box.Color = Color3.fromRGB(255, 255, 255)
        d.Box.Filled = false
        
        d.Line.Thickness = 1
        d.Line.Color = Color3.fromRGB(255, 255, 255)
        
        d.Name.Size = 14
        d.Name.Color = Color3.fromRGB(255, 255, 255)
        d.Name.Center = true
        d.Name.Outline = true
        
        d.HealthBG.Filled = true
        d.HealthBG.Color = Color3.fromRGB(50, 0, 0)
        
        d.HealthFill.Filled = true
        d.HealthFill.Color = Color3.fromRGB(0, 255, 0)
    end
    return ESPCache[plr]
end

Players.PlayerRemoving:Connect(removeESP)

-- Main Loop
RunService.RenderStepped:Connect(function()
    -- Center FOV Circle
    local viewportSize = Camera.ViewportSize
    local center = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
    FOVCircle.Position = center
    FOVCircle.Radius = Config.FOVRadius

    -- Character Modifications (Speed, Jump, Wallhack)
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = Config.Speed
            hum.JumpPower = Config.JumpPower
        end
        if Config.Noclip then
            for _, part in pairs(char:GetChildren()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end

    -- ESP Render Loop
    if Config.ESP then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local pos, onScreen, hrp = getTargetData(plr.Character)
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                local draw = getESP(plr)

                if onScreen and hum and hum.Health > 0 then
                    local head = plr.Character:FindFirstChild("Head")
                    local headPos = head and Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or pos
                    local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))

                    local height = math.abs(headPos.Y - legPos.Y)
                    local width = height / 2

                    draw.Box.Size = Vector2.new(width, height)
                    draw.Box.Position = Vector2.new(pos.X - width / 2, pos.Y - height / 2)
                    draw.Box.Visible = true

                    draw.Line.From = Vector2.new(viewportSize.X / 2, viewportSize.Y)
                    draw.Line.To = Vector2.new(pos.X, pos.Y + height / 2)
                    draw.Line.Visible = true

                    local dist = math.floor((hrp.Position - Camera.CFrame.Position).Magnitude)
                    draw.Name.Text = plr.Name .. " [" .. dist .. "m]"
                    draw.Name.Position = Vector2.new(pos.X, pos.Y - height / 2 - 16)
                    draw.Name.Visible = true

                    local healthPct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    draw.HealthBG.Size = Vector2.new(3, height)
                    draw.HealthBG.Position = Vector2.new(pos.X - width / 2 - 6, pos.Y - height / 2)
                    draw.HealthBG.Visible = true

                    draw.HealthFill.Size = Vector2.new(3, height * healthPct)
                    draw.HealthFill.Position = Vector2.new(pos.X - width / 2 - 6, (pos.Y + height / 2) - (height * healthPct))
                    draw.HealthFill.Color = Color3.fromRGB(255 * (1 - healthPct), 255 * healthPct, 0)
                    draw.HealthFill.Visible = true
                else
                    draw.Box.Visible = false
                    draw.Line.Visible = false
                    draw.Name.Visible = false
                    draw.HealthBG.Visible = false
                    draw.HealthFill.Visible = false
                end
            else
                removeESP(plr)
            end
        end
    end

    -- Aimbot Target Lock
    if Config.Aimbot then
        local closestDist = Config.FOVRadius
        LockedTarget = nil

        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local pos, onScreen, hrp = getTargetData(plr.Character)
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                if onScreen and hum and hum.Health > 0 then
                    local screenPos = Vector2.new(pos.X, pos.Y)
                    local dist = (screenPos - center).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        LockedTarget = plr.Character:FindFirstChild("Head") or hrp
                    end
                end
            end
        end

        if LockedTarget then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, LockedTarget.Position)
        end
    end
end)
