-- Helper Controls Generator
local function CreateToggle(name, stateKey, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(0.95, 0, 0, 35)
    Btn.BackgroundColor3 = State[stateKey] and Color3.fromRGB(0, 150, 75) or Color3.fromRGB(40, 40, 40)
    Btn.Text = name .. ": " .. (State[stateKey] and "BẬT" or "TẮT")
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Btn.TextSize = 14
    Btn.Font = Enum.Font.SourceSans
    Btn.Parent = Scroll
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = Btn
    
    Btn.MouseButton1Click:Connect(function()
        State[stateKey] = not State[stateKey]
        Btn.BackgroundColor3 = State[stateKey] and Color3.fromRGB(0, 150, 75) or Color3.fromRGB(40, 40, 40)
        Btn.Text = name .. ": " .. (State[stateKey] and "BẬT" or "TẮT")
        if callback then callback(State[stateKey]) end
    end)
    return Btn
end

local function CreateSlider(name, min, max, default, stateKey, callback)
    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(0.95, 0, 0, 45)
    Frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    Frame.Parent = Scroll
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = Frame
    
    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, 0, 0, 20)
    Label.BackgroundTransparency = 1
    Label.Text = name .. ": " .. tostring(default)
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.TextSize = 13
    Label.Font = Enum.Font.SourceSans
    Label.Parent = Frame
    
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(0.9, 0, 0, 15)
    Btn.Position = UDim2.new(0.05, 0, 0, 22)
    Btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    Btn.Text = ""
    Btn.Parent = Frame
    
    local Fill = Instance.new("Frame")
    Fill.Size = UDim2.new((default - min)/(max - min), 0, 1, 0)
    Fill.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    Fill.BorderSizePixel = 0
    Fill.Parent = Btn
    
    local dragging = false
    local function Update(input)
        local pos = math.clamp((input.Position.X - Btn.AbsolutePosition.X) / Btn.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + (max - min) * pos)
        Fill.Size = UDim2.new(pos, 0, 1, 0)
        Label.Text = name .. ": " .. tostring(val)
        State[stateKey] = val
        if callback then callback(val) end
    end
    
    Btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            Update(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            Update(input)
        end
    end)
end

