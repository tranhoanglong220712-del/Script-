-- ESP System
local ESPDrawings = {}

local function ClearESP(plr)
    if ESPDrawings[plr] then
        for _, obj in pairs(ESPDrawings[plr]) do
            obj:Remove()
        end
        ESPDrawings[plr] = nil
    end
end

local function UpdateESP()
    if not State.ESP then
        for plr, objs in pairs(ESPDrawings) do
            ClearESP(plr)
        end
        return
    end

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            if not ESPDrawings[plr] then
                ESPDrawings[plr] = {
                    Box = Drawing.new("Square"),
                    Name = Drawing.new("Text"),
                    Dist = Drawing.new("Text"),
                    Tracer = Drawing.new("Line"),
                    HealthBarOutline = Drawing.new("Square"),
                    HealthBar = Drawing.new("Square")
                }
                for _, d in pairs(ESPDrawings[plr]) do
                    d.Visible = false
                end
            end

            local objs = ESPDrawings[plr]
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")

            if char and hum and hrp and hum.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    local head = char:FindFirstChild("Head")
                    local headPos = head and Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
                    local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))

                    local height = math.abs(headPos.Y - legPos.Y)
                    local width = height / 2

                    -- Raycast visibility check
                    local ray = Ray.new(Camera.CFrame.Position, (hrp.Position - Camera.CFrame.Position).Unit * 500)
                    local hit = Workspace:FindPartOnWithIgnoreList(ray, {LocalPlayer.Character, char})
                    local isVisible = not hit
                    local color = isVisible and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)

                    objs.Box.Size = Vector2.new(width, height)
                    objs.Box.Position = Vector2.new(pos.X - width / 2, pos.Y - height / 2)
                    objs.Box.Color = color
                    objs.Box.Thickness = 1.5
                    objs.Box.Visible = true

                    objs.Name.Text = plr.Name
                    objs.Name.Size = 14
                    objs.Name.Center = true
                    objs.Name.Outline = true
                    objs.Name.Color = Color3.fromRGB(255, 255, 255)
                    objs.Name.Position = Vector2.new(pos.X, pos.Y - height / 2 - 16)
                    objs.Name.Visible = true

                    local distMeters = math.floor((hrp.Position - Camera.CFrame.Position).Magnitude)
                    objs.Dist.Text = distMeters .. "m"
                    objs.Dist.Size = 12
                    objs.Dist.Center = true
                    objs.Dist.Outline = true
                    objs.Dist.Color = Color3.fromRGB(255, 255, 255)
                    objs.Dist.Position = Vector2.new(pos.X, pos.Y + height / 2 + 2)
                    objs.Dist.Visible = true

                    objs.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    objs.Tracer.To = Vector2.new(pos.X, pos.Y + height / 2)
                    objs.Tracer.Color = color
                    objs.Tracer.Thickness = 1
                    objs.Tracer.Visible = true

                    local healthPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    objs.HealthBarOutline.Size = Vector2.new(4, height)
                    objs.HealthBarOutline.Position = Vector2.new(pos.X - width / 2 - 6, pos.Y - height / 2)
                    objs.HealthBarOutline.Color = Color3.fromRGB(0, 0, 0)
                    objs.HealthBarOutline.Filled = true
                    objs.HealthBarOutline.Visible = true

                    objs.HealthBar.Size = Vector2.new(2, height * healthPercent)
                    objs.HealthBar.Position = Vector2.new(pos.X - width / 2 - 5, pos.Y + height / 2 - (height * healthPercent))
                    objs.HealthBar.Color = Color3.fromRGB(255 * (1 - healthPercent), 255 * healthPercent, 0)
                    objs.HealthBar.Filled = true
                    objs.HealthBar.Visible = true
                else
                    for _, d in pairs(objs) do d.Visible = false end
                end
            else
                for _, d in pairs(objs) do d.Visible = false end
            end
        end
    end
end

