-- Loop Xử Lý Chức Năng Main
RunService.RenderStepped:Connect(function()
    local Char = LocalPlayer.Character
    if not Char then return end
    local Hum = Char:FindFirstChildOfClass("Humanoid")
    local HRP = Char:FindFirstChild("HumanoidRootPart")

    -- 4. Speed & 5. Jump
    if Hum then
        Hum.WalkSpeed = 16 + (Config.Speed - 1) * 1.5
        Hum.JumpPower = 50 + (Config.Jump - 1) * 3
    end

    -- 6. Fly
    if Config.Fly and HRP then
        if not FlyBodyVel then
            FlyBodyVel = Instance.new("BodyVelocity")
            FlyBodyVel.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            FlyBodyVel.Parent = HRP
            FlyBodyGyro = Instance.new("BodyGyro")
            FlyBodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
            FlyBodyGyro.Parent = HRP
        end
        FlyBodyGyro.CFrame = Camera.CFrame
        FlyBodyVel.Velocity = Camera.CFrame.LookVector * FlySpeed
    else
        if FlyBodyVel then FlyBodyVel:Destroy() FlyBodyVel = nil end
        if FlyBodyGyro then FlyBodyGyro:Destroy() FlyBodyGyro = nil end
    end

    -- 7. Tàng hình
    if Char then
        for _, p in pairs(Char:GetChildren()) do
            if p:IsA("BasePart") then
                p.LocalTransparencyModifier = Config.Invisible and 1 or 0
            end
        end
    end

    -- 8. Bất tử
    if Config.GodMode and Hum then
        Hum.Health = Hum.MaxHealth
    end

    -- 10. FOV Update
    if FOVCircle then
        FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        FOVCircle.Radius = Config.FOVSize
    end

    -- 9. Aimbot
    if Config.Aimbot and HRP then
        local Closest = nil
        local ShortestDist = Config.FOVSize
        local Center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local Pos, OnScreen = Camera:WorldToViewportPoint(plr.Character.HumanoidRootPart.Position)
                if OnScreen then
                    local Dist = (Vector2.new(Pos.X, Pos.Y) - Center).Magnitude
                    if Dist < ShortestDist then
                        ShortestDist = Dist
                        Closest = plr.Character.HumanoidRootPart
                    end
                end
            end
        end
        if Closest then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, Closest.Position)
        end
    end

    -- 11. Wallhack / Noclip
    if Config.Wallhack and Char then
        for _, p in pairs(Char:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
            end
        end
    end

    -- 13. Ghost Mode
    if Config.GhostMode and Char then
        for _, p in pairs(Char:GetChildren()) do
            if p:IsA("BasePart") then p.Transparency = 1 end
        end
        LocalPlayer.CameraMode = Enum.CameraMode.Classic
    end
end)

-- 12. Dịch chuyển khi bấm màn hình
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if Config.Teleport and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) then
        local UnitRay = Camera:ScreenPointToRay(input.Position.X, input.Position.Y)
        local RayResult = Workspace:Raycast(UnitRay.Origin, UnitRay.Direction * 1000)
        if RayResult and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(RayResult.Position + Vector3.new(0, 3, 0))
        end
    end
end)

-- 2. ESP Player & 3. Item ESP (Highlight-based Support Universal Mobile)
local HighlightGroup = Instance.new("Folder")
HighlightGroup.Name = "ESPHighlights"
HighlightGroup.Parent = CoreGui

RunService.RenderStepped:Connect(function()
    HighlightGroup:ClearAllChildren()

    if Config.ESP then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local Hl = Instance.new("Highlight")
                Hl.Adornee = plr.Character
                Hl.FillColor = Color3.fromRGB(255, 0, 0)
                Hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                Hl.Parent = HighlightGroup
            end
        end
    end

    if Config.ItemESP then
        for _, item in pairs(Workspace:GetDescendants()) do
            if item:IsA("Tool") or item:IsA("TouchTransmitter") then
                local Target = item:IsA("Tool") and item or item.Parent
                if Target and Target:IsA("BasePart") or Target:IsA("Model") then
                    local Hl = Instance.new("Highlight")
                    Hl.Adornee = Target
                    Hl.FillColor = Color3.fromRGB(255, 255, 0)
                    Hl.OutlineColor = Color3.fromRGB(0, 255, 0)
                    Hl.Parent = HighlightGroup
                end
            end
        end
    end
end)
