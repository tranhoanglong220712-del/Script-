-- Tạo UI Controls
local function CreateToggle(name, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 0, 35)
    Btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    Btn.Text = name .. ": TẮT"
    Btn.TextColor3 = Color3.fromRGB(255, 85, 85)
    Btn.Font = Enum.Font.SourceSans
    Btn.TextSize = 14
    Btn.Parent = Scroll

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = Btn

    local State = false
    Btn.MouseButton1Click:Connect(function()
        State = not State
        Btn.Text = name .. ": " .. (State and "BẬT" or "TẮT")
        Btn.TextColor3 = State and Color3.fromRGB(85, 255, 85) or Color3.fromRGB(255, 85, 85)
        callback(State)
    end)
    return Btn
end

local function CreateSlider(name, min, max, default, callback)
    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(1, 0, 0, 45)
    Frame.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    Frame.Parent = Scroll

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = Frame

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, 0, 0, 20)
    Label.BackgroundTransparency = 1
    Label.Text = name .. ": " .. tostring(default)
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.Font = Enum.Font.SourceSans
    Label.TextSize = 14
    Label.Parent = Frame

    local SliderBtn = Instance.new("TextButton")
    SliderBtn.Size = UDim2.new(0.9, 0, 0, 15)
    SliderBtn.Position = UDim2.new(0.05, 0, 0.55, 0)
    SliderBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    SliderBtn.Text = ""
    SliderBtn.Parent = Frame

    local Fill = Instance.new("Frame")
    Fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    Fill.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
    Fill.BorderSizePixel = 0
    Fill.Parent = SliderBtn

    local Active = false
    local function Update(input)
        local Pos = math.clamp((input.Position.X - SliderBtn.AbsolutePosition.X) / SliderBtn.AbsoluteSize.X, 0, 1)
        Fill.Size = UDim2.new(Pos, 0, 1, 0)
        local Val = math.floor(min + (max - min) * Pos)
        Label.Text = name .. ": " .. tostring(Val)
        callback(Val)
    end

    SliderBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Active = true
            Update(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Active = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if Active and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            Update(input)
        end
    end)
end

