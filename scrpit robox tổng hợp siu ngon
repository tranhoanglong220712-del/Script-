local function GetClosestPlayer()
    local target = nil
    local dist = Features.AimbotRadius
    local mousePos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") and player.Character:FindFirstChildOfClass("Humanoid") then
            if player.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
                local head = player.Character.Head
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local magnitude = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                    if magnitude < dist then
                        dist = magnitude
                        target = head
                    end
                end
            end
        end
    end
    return target
end

RunService.RenderStepped:Connect(function()
    if DrawingObjects.FOV then
        DrawingObjects.FOV.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    end

    if Features.Aimbot then
        local target = GetClosestPlayer()
        if target then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
        end
    end

    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")

        if hum then
            hum.WalkSpeed = Features.Speed
            hum.JumpPower = Features.Jump

            if Features.GodMode then
                hum.Health = hum.MaxHealth
            end
        end

        if Features.Invisible then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") or part:IsA("Decal") then
                    part.Transparency = 1
                end
            end
        end

        if Features.Fly and root then
            root.Velocity = Camera.CFrame.LookVector * Features.FlySpeed
        end
    end
end)

local function RemoveESP(player)
    if DrawingObjects.ESP[player] then
        for _, obj in pairs(DrawingObjects.ESP[player]) do
            if obj.Remove then obj:Remove() end
        end
        DrawingObjects.ESP[player] = nil
    end
end

local function CreateESP(player)
    if not Drawing then return end
    local box = Drawing.new("Square")
    box.Thickness = 1
    box.Color = Color3.fromRGB(255, 0, 0)
    box.Filled = false
    box.Visible = false

    local txt = Drawing.new("Text")
    txt.Size = 14
    txt.Center = true
    txt.Outline = true
    txt.Color = Color3.fromRGB(255, 255, 255)
    txt.Visible = false

    local line = Drawing.new("Line")
    line.Thickness = 1
    line.Color = Color3.fromRGB(255, 0, 0)
    line.Visible = false

    DrawingObjects.ESP[player] = {Box = box, Text = txt, Line = line}
end

Players.PlayerRemoving:Connect(RemoveESP)

RunService.RenderStepped:Connect(function()
    if not Drawing then return end
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if not DrawingObjects.ESP[player] then
                CreateESP(player)
            end

            local esp = DrawingObjects.ESP[player]
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
                local root = char.HumanoidRootPart
                local hum = char:FindFirstChildOfClass("Humanoid")
                local pos, onScreen = Camera:WorldToViewportPoint(root.Position)

                if onScreen and hum.Health > 0 then
                    local dist = (Camera.CFrame.Position - root.Position).Magnitude
                    local scale = (1 / pos.Z) * 1000
                    local w = 2 * scale
                    local h = 3 * scale

                    if Features.ESPBox then
                        esp.Box.Size = Vector2.new(w, h)
                        esp.Box.Position = Vector2.new(pos.X - w/2, pos.Y - h/2)
                        esp.Box.Visible = true
                    else
                        esp.Box.Visible = false
                    end

                    if Features.ESPName or Features.ESPDist or Features.ESPHealth then
                        local infoStr = ""
                        if Features.ESPName then infoStr = infoStr .. player.Name .. "\n" end
                        if Features.ESPDist then infoStr = infoStr .. "[" .. math.floor(dist) .. "m]\n" end
                        if Features.ESPHealth then infoStr = infoStr .. "Máu: " .. math.floor(hum.Health) end
                        
                        esp.Text.Text = infoStr
                        esp.Text.Position = Vector2.new(pos.X, pos.Y - h/2 - 20)
                        esp.Text.Visible = true
                    else
                        esp.Text.Visible = false
                    end

                    if Features.ESPLine then
                        esp.Line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        esp.Line.To = Vector2.new(pos.X, pos.Y)
                        esp.Line.Visible = true
                    else
                        esp.Line.Visible = false
                    end

                    if Features.ESPWall then
                        for _, part in pairs(char:GetChildren()) do
                            if part:IsA("BasePart") then
                                part.LocalTransparencyModifier = 0
                            end
                        end
                    end
                else
                    esp.Box.Visible = false
                    esp.Text.Visible = false
                    esp.Line.Visible = false
                end
            else
                if esp then
                    esp.Box.Visible = false
                    esp.Text.Visible = false
                    esp.Line.Visible = false
                end
            end
        end
    end
end)
