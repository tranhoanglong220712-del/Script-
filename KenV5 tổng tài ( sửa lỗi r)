local function GetESPComponents(plr)
    if not DrawObjs[plr] then
        DrawObjs[plr] = {
            Box = Drawing.new("Square"),
            Name = Drawing.new("Text"),
            Dist = Drawing.new("Text"),
            Tracer = Drawing.new("Line"),
            HealthBg = Drawing.new("Line"),
            Health = Drawing.new("Line")
        }
        local d = DrawObjs[plr]
        d.Box.Thickness = 1.5
        d.Box.Filled = false
        
        d.Name.Size = 14
        d.Name.Center = true
        d.Name.Outline = true
        d.Name.Color = Color3.fromRGB(255, 255, 255)
        
        d.Dist.Size = 12
        d.Dist.Center = true
        d.Dist.Outline = true
        d.Dist.Color = Color3.fromRGB(200, 200, 200)

        d.Tracer.Thickness = 1
        d.HealthBg.Thickness = 3
        d.HealthBg.Color = Color3.fromRGB(50, 50, 50)
        d.Health.Thickness = 1.5
        d.Health.Color = Color3.fromRGB(0, 255, 0)
    end
    return DrawObjs[plr]
end

