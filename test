local speedOn = true
local invisOn = false
local speedValue = 32
local jumpValue = 50

spawn(function()
    while wait(0.03) do
        if mainFrame.Visible then
            moonEffect.Rotation = (moonEffect.Rotation or 0) + 0.5
            moonEffect.ImageColor3 = Color3.fromRGB(
                160 + math.sin(tick() * 0.8) * 40,
                160 + math.cos(tick() * 0.6) * 40,
                255
            )
            glow.Rotation = (glow.Rotation or 0) + 0.2
        end
    end
end)

toggleBtn.MouseButton1Click:Connect(function()
    mainFrame.Visible = not mainFrame.Visible
    mainFrame.BackgroundTransparency = 0
end)

speedSlider:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
    local pos = speedSlider.CanvasPosition.X / speedSlider.AbsoluteSize.X
    speedValue = math.floor(pos * 700)
    speedValue = math.clamp(speedValue, 0, 700)
    speedVal.Text = tostring(speedValue)
    local x = math.floor(speedValue / 16 + 0.5)
    speedLbl.Text = "⚡ Tốc Độ: x" .. x
    if speedOn and hum then
        hum.WalkSpeed = speedValue
    end
    speedBar.Size = UDim2.new(pos, 0, 1, 0)
end)

speedOnBtn.MouseButton1Click:Connect(function()
    speedOn = not speedOn
    speedOnBtn.Text = speedOn and "BẬT" or "TẮT"
    speedOnBtn.TextColor3 = speedOn and Color3.fromRGB(0,255,0) or Color3.fromRGB(255,0,0)
    if not speedOn and hum then
        hum.WalkSpeed = 16
    elseif speedOn and hum then
        hum.WalkSpeed = speedValue
    end
end)

jumpSlider:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
    local pos = jumpSlider.CanvasPosition.X / jumpSlider.AbsoluteSize.X
    jumpValue = math.floor(pos * 270 + 30)
    jumpValue = math.clamp(jumpValue, 30, 300)
    jumpVal.Text = tostring(jumpValue)
    jumpLbl.Text = "🦘 Nhảy Cao: " .. jumpValue
    if hum then
        hum.JumpPower = jumpValue
    end
    jumpBar.Size = UDim2.new(pos, 0, 1, 0)
end)

invisBtn.MouseButton1Click:Connect(function()
    invisOn = not invisOn
    invisBtn.Text = invisOn and "BẬT" or "TẮT"
    invisBtn.TextColor3 = invisOn and Color3.fromRGB(0,255,0) or Color3.fromRGB(255,0,0)
    invisLbl.Text = "👻 Tàng Hình: " .. (invisOn and "BẬT" or "TẮT")
    if char then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Transparency = invisOn and 1 or 0
            end
        end
    end
end)

deleteBtn.MouseButton1Click:Connect(function()
    confirmFrame.Visible = true
end)

yesBtn.MouseButton1Click:Connect(function()
    gui:Destroy()
end)

noBtn.MouseButton1Click:Connect(function()
    confirmFrame.Visible = false
end)

player.CharacterAdded:Connect(function(newChar)
    char = newChar
    hum = char:WaitForChild("Humanoid")
    wait(0.3)
    if speedOn then
        hum.WalkSpeed = speedValue
    end
    hum.JumpPower = jumpValue
    if invisOn then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Transparency = 1
            end
        end
    end
end)