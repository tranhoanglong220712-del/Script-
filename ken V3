-- Tự Ngắm (Aimbot) & Vòng Tròn FOV
RunService.RenderStepped:Connect(function()
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    if Settings.Aimbot_Enabled and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
        local Target = nil
        local MaxDist = Settings.FOV_Radius
        local Center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") then
                local Pos, OnScreen = Camera:WorldToViewportPoint(plr.Character.Head.Position)
                if OnScreen then
                    local Dist = (Vector2.new(Pos.X, Pos.Y) - Center).Magnitude
                    if Dist < MaxDist then
                        MaxDist = Dist
                        Target = plr.Character.Head
                    end
                end
            end
        end

        if Target then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, Target.Position)
        end
    end
end)

-- Cập Nhật Nhân Vật (Tốc độ, Nhảy, Bất tử, Tàng hình)
RunService.Heartbeat:Connect(function()
    local Char = LocalPlayer.Character
    if Char and Char:FindFirstChild("Humanoid") then
        local Hum = Char.Humanoid
        
        -- Speed & Jump
        Hum.WalkSpeed = 16 + (Settings.Speed_Value - 1) * 1.5
        Hum.JumpPower = 50 + (Settings.Jump_Value - 1) * 2.5
        
        -- God Mode
        if Settings.GodMode_Enabled then
            Hum.Health = Hum.MaxHealth
        end
        
        -- Invisible
        if Settings.Invisible_Enabled then
            for _, p in pairs(Char:GetChildren()) do
                if p:IsA("BasePart") then p.Transparency = 1 end
                if p:IsA("Accessory") and p:FindFirstChild("Handle") then p.Handle.Transparency = 1 end
            end
        end
        
        -- Wallhack Character
        if Settings.Wallhack_Enabled then
            for _, p in pairs(Char:GetChildren()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end
    end
end)

-- Bay (Fly)
local FlyBodyVel, FlyBodyGyro
RunService.RenderStepped:Connect(function()
    local Char = LocalPlayer.Character
    if Char and Char:FindFirstChild("HumanoidRootPart") then
        local HRP = Char.HumanoidRootPart
        if Settings.Fly_Enabled then
            if not FlyBodyVel then
                FlyBodyVel = Instance.new("BodyVelocity")
                FlyBodyVel.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                FlyBodyVel.Parent = HRP
                
                FlyBodyGyro = Instance.new("BodyGyro")
                FlyBodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
                FlyBodyGyro.Parent = HRP
            end
            
            FlyBodyGyro.CFrame = Camera.CFrame
            local MoveDir = Char.Humanoid.MoveDirection
            if MoveDir.Magnitude > 0 then
                FlyBodyVel.Velocity = Camera.CFrame.LookVector * (Settings.Speed_Value * 10)
            else
                FlyBodyVel.Velocity = Vector3.new(0, 0.1, 0)
            end
        else
            if FlyBodyVel then FlyBodyVel:Destroy() FlyBodyVel = nil end
            if FlyBodyGyro then FlyBodyGyro:Destroy() FlyBodyGyro = nil end
        end
    end
end)

-- Biến Mất (Ghost Mode)
local GhostClone
RunService.Heartbeat:Connect(function()
    local Char = LocalPlayer.Character
    if Settings.Ghost_Enabled then
        if Char and Char:FindFirstChild("HumanoidRootPart") and not GhostClone then
            Char.Archivable = true
            GhostClone = Char:Clone()
            GhostClone.Parent = Workspace
            for _, p in pairs(Char:GetChildren()) do
                if p:IsA("BasePart") then p.Transparency = 1 end
            end
        end
    else
        if GhostClone then
            GhostClone:Destroy()
            GhostClone = nil
            if Char then
                for _, p in pairs(Char:GetChildren()) do
                    if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then p.Transparency = 0 end
                end
            end
        end
    end
end)

-- Dịch Chuyển Tức Thời (Teleport)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if Settings.Teleport_Enabled and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
        local Pos = input.Position
        local Ray = Camera:ScreenPointToRay(Pos.X, Pos.Y)
        local RaycastResult = Workspace:Raycast(Ray.Origin, Ray.Direction * 1000)
        
        if RaycastResult and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(RaycastResult.Position + Vector3.new(0, 3, 0))
        end
    end
end)

-- Hệ Thống Định Vị (Player ESP System)
local function CreateESP(plr)
    local Box = Drawing.new("Square")
    Box.Thickness = 1
    Box.Filled = false
    Box.Color = Color3.fromRGB(255, 0, 0)
    
    local Name = Drawing.new("Text")
    Name.Size = 14
    Name.Center = true
    Name.Outline = true
    Name.Color = Color3.fromRGB(255, 255, 255)
    
    local Distance = Drawing.new("Text")
    Distance.Size = 12
    Distance.Center = true
    Distance.Outline = true
    Distance.Color = Color3.fromRGB(200, 200, 200)
    
    local Health = Drawing.new("Line")
    Health.Thickness = 2
    Health.Color = Color3.fromRGB(0, 255, 0)
    
    local Tracer = Drawing.new("Line")
    Tracer.Thickness = 1
    Tracer.Color = Color3.fromRGB(255, 255, 0)

    ESP_Cache[plr] = {Box = Box, Name = Name, Distance = Distance, Health = Health, Tracer = Tracer}
end

local function RemoveESP(plr)
    if ESP_Cache[plr] then
        for _, obj in pairs(ESP_Cache[plr]) do
            obj:Remove()
        end
        ESP_Cache[plr] = nil
    end
end

for _, plr in pairs(Players:GetPlayers()) do
    if plr ~= LocalPlayer then CreateESP(plr) end
end

Players.PlayerAdded:Connect(function(plr)
    if plr ~= LocalPlayer then CreateESP(plr) end
end)

Players.PlayerRemoving:Connect(RemoveESP)

RunService.RenderStepped:Connect(function()
    for plr, esp in pairs(ESP_Cache) do
        if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Humanoid") then
            local HRP = plr.Character.HumanoidRootPart
            local Hum = plr.Character.Humanoid
            local Pos, OnScreen = Camera:WorldToViewportPoint(HRP.Position)
            
            if OnScreen then
                local Size = (Camera:WorldToViewportPoint(HRP.Position + Vector3.new(0, 3, 0)).Y - Camera:WorldToViewportPoint(HRP.Position - Vector3.new(0, 3, 0)).Y)
                local BoxSize = Vector2.new(math.abs(Size * 0.6), math.abs(Size))
                local BoxPos = Vector2.new(Pos.X - BoxSize.X / 2, Pos.Y - BoxSize.Y / 2)
                
                -- Box
                esp.Box.Visible = Settings.ESP_Box
                esp.Box.Size = BoxSize
                esp.Box.Position = BoxPos
                
                -- Name
                esp.Name.Visible = Settings.ESP_Name
                esp.Name.Text = plr.Name
                esp.Name.Position = Vector2.new(Pos.X, BoxPos.Y - 16)
                
                -- Distance
                esp.Distance.Visible = Settings.ESP_Distance
                local Dist = math.floor((HRP.Position - Camera.CFrame.Position).Magnitude)
                esp.Distance.Text = tostring(Dist) .. "m"
                esp.Distance.Position = Vector2.new(Pos.X, BoxPos.Y + BoxSize.Y + 2)
                
                -- Health
                esp.Health.Visible = Settings.ESP_Health
                local HealthPercent = Hum.Health / Hum.MaxHealth
                esp.Health.From = Vector2.new(BoxPos.X - 5, BoxPos.Y + BoxSize.Y)
                esp.Health.To = Vector2.new(BoxPos.X - 5, BoxPos.Y + BoxSize.Y - (BoxSize.Y * HealthPercent))
                
             