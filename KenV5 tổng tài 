            pName.Size = UDim2.new(1, -25, 1, 0)
            pName.Position = UDim2.new(0, 22, 0, 0)
            pName.BackgroundTransparency = 1
            pName.Text = p.DisplayName .. " (@" .. p.Name .. ")"
            pName.TextColor3 = Color3.fromRGB(255, 255, 255)
            pName.Font = Enum.Font.ArialBold
            pName.TextSize = 11
            pName.TextXAlignment = Enum.TextXAlignment.Left
            pName.Parent = item

            cb.MouseButton1Click:Connect(function()
                if SelectedPlayers[p] then
                    SelectedPlayers[p] = nil
                    cb.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
                else
                    SelectedPlayers[p] = true
                    cb.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
                end
            end)
        end
    end
    KickScroll.CanvasSize = UDim2.new(0, 0, 0, count * 22)
end

